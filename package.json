{
  "name": "matricula-cin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "seed": "node apps/api/src/seed.ts",
    "dev": "node --watch apps/api/src/server.ts --dev",
    "start": "node apps/api/src/server.ts",
    "build": "tsc --noEmit && vite build apps/web",
    "check": "tsc --noEmit",
    "test": "node --test apps/api/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.1.0"
  }
}
